# ================================================================
#  Screen Assistant Configuration Example
#  Copy this file to .env and insert your API keys
# ================================================================

# AI Provider: "gemini" (recommended) or "groq"
AI_PROVIDER=gemini

# Google Gemini API Configuration (free key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Groq API Configuration (free key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.1

# Optional Port and Language Settings
SCREEN_CDP_PORT=9222
SCREEN_OCR_LANG=en
